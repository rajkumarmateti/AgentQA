# InvenTree instance (Platform UI lives under /web)
BASE_URL=http://localhost:8000

# User with Part create/change/delete permission
INVENTREE_USERNAME=admin
INVENTREE_PASSWORD=inventree

# Optional: user without Part create permission (UI-PART-012)
INVENTREE_READONLY_USERNAME=reader
INVENTREE_READONLY_PASSWORD=readonly

# Timeouts
NAVIGATION_TIMEOUT_MS=30000
ACTION_TIMEOUT_MS=15000
