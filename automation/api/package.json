{
  "name": "inventree-parts-api-automation",
  "private": true,
  "version": "1.0.0",
  "description": "Playwright API tests for the InvenTree Parts module",
  "scripts": {
    "test": "playwright test",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:one": "playwright test --grep",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.3"
  }
}
